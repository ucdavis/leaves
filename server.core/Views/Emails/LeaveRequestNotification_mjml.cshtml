@model Server.Core.Notification.LeaveRequestNotificationTemplateModel

@{
    ViewData["EmailPreview"] = Model.Header;
    Layout = "/Views/Shared/_NotificationLayout_mjml.cshtml";
    var content = Model.Content;
}

<mj-section css-class="notification-content" padding="36px 36px 12px 36px">
  <mj-column padding="0px">
    <mj-text css-class="notification-title"
             align="center"
             font-size="26px"
             font-weight="700"
             line-height="1.3"
             color="#172033"
             padding="0px 0px 12px 0px">
      <h1 style="margin:0;font-size:inherit;font-weight:inherit;line-height:inherit;">@Model.Header</h1>
    </mj-text>
    <mj-table css-class="notification-details" cellpadding="0" cellspacing="0"
              font-size="14px" line-height="1.5" padding="0px" table-layout="fixed">
      @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Name", content.RequesterName))
      @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Email", content.RequesterEmail))
      @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Department", content.Department))
      @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Leave type", content.LeaveType))
      @if (!string.IsNullOrWhiteSpace(content.PayLeaveType))
      {
        @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("FMLA pay type", content.PayLeaveType))
      }
      @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Date(s)", content.Dates))
      @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Total hours", content.TotalHours))
      @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Note", content.Note))
      @if (content.IsApproved)
      {
        @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Approved by", content.DecidedBy))
        @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Approval comment", content.DecisionComment))
      }
      else
      {
        @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Status", content.Status))
        @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Decided by", content.DecidedBy))
        @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Comment", content.DecisionComment))
      }
      @await Html.PartialAsync("/Views/Shared/_LeaveRequestDetailRow_mjml.cshtml", new Server.Core.Notification.LeaveRequestDetailRow("Request ID", content.RequestId, IsFinalRow: true))
    </mj-table>
  </mj-column>
</mj-section>
