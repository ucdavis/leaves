@model Server.Core.Notification.DefaultNotificationTemplateModel

@{
    Layout = "/Views/Shared/_NotificationLayout_mjml.cshtml";
}

<mj-section padding="20px 36px 12px 36px">
  <mj-column>
    <mj-text css-class="notification-title"
             align="center"
             font-size="24px"
             font-weight="700"
             line-height="1.3"
             padding-bottom="18px"
             text-transform="uppercase">
      <span class="notification-title-content" style="overflow-wrap:normal;word-break:normal;white-space:normal;">@Model.Header</span>
    </mj-text>
    @foreach (var paragraph in Model.Paragraphs)
    {
      var lines = paragraph.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
      if (lines.Length > 1)
      {
        <mj-text padding="0px 0px 18px 0px">
          <span style="color:#003a5d;font-size:16px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;">
            @lines[0]
          </span>
          <br />
          @foreach (var line in lines.Skip(1))
          {
            var separatorIndex = line.IndexOf(':');
            if (separatorIndex > 0)
            {
              <strong>@line[..(separatorIndex + 1)]</strong>@line[(separatorIndex + 1)..]<br />
            }
            else
            {
              @line<br />
            }
          }
        </mj-text>
      }
      else
      {
        <mj-text padding="0px 0px 14px 0px">
          @paragraph
        </mj-text>
      }
    }
  </mj-column>
</mj-section>

@if (!string.IsNullOrWhiteSpace(Model.ButtonText) && !string.IsNullOrWhiteSpace(Model.ButtonUrl))
{
  @await Html.PartialAsync("/Views/Shared/_NotificationButton_mjml.cshtml", new Server.Core.Notification.NotificationButtonModel(Model.ButtonText, Model.ButtonUrl))
}
